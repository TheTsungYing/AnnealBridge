{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.TheTsungYing/annealbridge",
  "title": "AnnealBridge",
  "description": "Optimization middleware for AI agents: JSON problem in, verified and ranked solutions out.",
  "repository": {
    "url": "https://github.com/TheTsungYing/AnnealBridge",
    "source": "github"
  },
  "websiteUrl": "https://pypi.org/project/annealbridge/",
  "version": "0.3.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "annealbridge",
      "version": "0.3.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "annealbridge[mcp]"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ANNEALBRIDGE_ALLOW_REMOTE",
          "description": "Set to true to allow remote vendor backends; local backends need nothing.",
          "isRequired": false,
          "isSecret": false,
          "format": "string",
          "default": "false"
        }
      ]
    }
  ]
}
