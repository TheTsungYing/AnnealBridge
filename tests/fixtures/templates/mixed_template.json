{
  "version": "1.3",
  "name": "mixed_template",
  "description": "Explicit entries next to templates: the explicit variable bonus, an explicit quadratic term, an explicit constraint and an explicit cardinality constraint that name generated variables (pick[a] ...), an integer family qty, a constraint template without for_each (id budget), a soft template whose rhs and weight are parameters, and a cardinality template whose rhs is a parameter and whose group index g is used only in the member's where.",
  "index_sets": [
    {"name": "item", "elements": ["a", "b", "c"]},
    {"name": "group", "elements": ["g1", "g2"]}
  ],
  "parameters": [
    {"name": "value", "indices": ["item"], "values": [{"key": ["a"], "value": 5}, {"key": ["b"], "value": 4}, {"key": ["c"], "value": 3}]},
    {"name": "unit", "indices": ["item"], "values": [{"key": ["a"], "value": 1}, {"key": ["b"], "value": 2}, {"key": ["c"], "value": 1}]},
    {"name": "cost", "indices": ["item"], "values": [{"key": ["a"], "value": 2}, {"key": ["b"], "value": 1}, {"key": ["c"], "value": 1}]},
    {"name": "target", "indices": ["item"], "default": 0, "values": [{"key": ["a"], "value": 1}]},
    {"name": "penalty", "indices": ["item"], "values": [{"key": ["a"], "value": 2}, {"key": ["b"], "value": 0.5}, {"key": ["c"], "value": 1.5}]},
    {
      "name": "in_group",
      "indices": ["group", "item"],
      "default": 0,
      "values": [
        {"key": ["g1", "a"], "value": 1},
        {"key": ["g1", "b"], "value": 1},
        {"key": ["g2", "b"], "value": 1},
        {"key": ["g2", "c"], "value": 1}
      ]
    },
    {"name": "limit", "indices": ["group"], "values": [{"key": ["g1"], "value": 1}, {"key": ["g2"], "value": 1}]}
  ],
  "variable_families": [
    {"name": "pick", "indices": ["item"], "type": "binary", "description": "1 iff the item is picked"},
    {"name": "qty", "indices": ["item"], "type": "integer", "lower_bound": 0, "upper_bound": 3, "description": "Extra units of the item"}
  ],
  "variables": [
    {"name": "bonus", "type": "binary", "description": "Bonus, only with item a"}
  ],
  "objective": {
    "direction": "maximize",
    "linear_terms": [{"variable": "bonus", "coefficient": 2}],
    "quadratic_terms": [{"variable1": "bonus", "variable2": "pick[a]", "coefficient": 1}],
    "linear_term_templates": [
      {"for_each": ["i in item"], "coefficient": "value[i]", "variable": "pick[i]"},
      {"for_each": ["i in item"], "coefficient": "unit[i]", "variable": "qty[i]"}
    ]
  },
  "constraints": [
    {
      "id": "bonus_needs_a",
      "type": "hard",
      "terms": [{"variable": "bonus", "coefficient": 1}, {"variable": "pick[a]", "coefficient": -1}],
      "operator": "<=",
      "rhs": 0
    }
  ],
  "constraint_templates": [
    {
      "id": "budget",
      "description": "Units and picks share one budget",
      "type": "hard",
      "terms": [
        {"for_each": ["i in item"], "coefficient": "unit[i]", "variable": "qty[i]"},
        {"for_each": ["i in item"], "coefficient": "cost[i]", "variable": "pick[i]"}
      ],
      "operator": "<=",
      "rhs": 4
    },
    {
      "id": "prefer_small",
      "description": "Rather few extra units",
      "type": "soft",
      "for_each": ["i in item"],
      "terms": [{"coefficient": 1, "variable": "qty[i]"}],
      "operator": "<=",
      "rhs": "target[i]",
      "weight": "penalty[i]"
    }
  ],
  "cardinality_constraints": [
    {"id": "at_least_one", "type": "hard", "variables": ["pick[a]", "pick[b]", "pick[c]"], "operator": ">=", "rhs": 1}
  ],
  "cardinality_constraint_templates": [
    {
      "id": "group_limit",
      "description": "At most limit[g] picks per group",
      "type": "hard",
      "for_each": ["g in group"],
      "variables": [{"for_each": ["i in item"], "where": ["in_group[g,i] == 1"], "variable": "pick[i]"}],
      "operator": "<=",
      "rhs": "limit[g]"
    }
  ],
  "solver": {"backend": "exact"}
}
