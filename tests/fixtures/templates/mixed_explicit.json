{
  "version": "1.3",
  "name": "mixed_template",
  "description": "Explicit entries next to templates: the explicit variable bonus, an explicit quadratic term, an explicit constraint and an explicit cardinality constraint that name generated variables (pick[a] ...), an integer family qty, a constraint template without for_each (id budget), a soft template whose rhs and weight are parameters, and a cardinality template whose rhs is a parameter and whose group index g is used only in the member's where.",
  "variables": [
    {"name": "bonus", "type": "binary", "description": "Bonus, only with item a"},
    {"name": "pick[a]", "type": "binary", "description": "1 iff the item is picked"},
    {"name": "pick[b]", "type": "binary", "description": "1 iff the item is picked"},
    {"name": "pick[c]", "type": "binary", "description": "1 iff the item is picked"},
    {"name": "qty[a]", "type": "integer", "lower_bound": 0, "upper_bound": 3, "description": "Extra units of the item"},
    {"name": "qty[b]", "type": "integer", "lower_bound": 0, "upper_bound": 3, "description": "Extra units of the item"},
    {"name": "qty[c]", "type": "integer", "lower_bound": 0, "upper_bound": 3, "description": "Extra units of the item"}
  ],
  "objective": {
    "direction": "maximize",
    "linear_terms": [
      {"variable": "bonus", "coefficient": 2},
      {"variable": "pick[a]", "coefficient": 5},
      {"variable": "pick[b]", "coefficient": 4},
      {"variable": "pick[c]", "coefficient": 3},
      {"variable": "qty[a]", "coefficient": 1},
      {"variable": "qty[b]", "coefficient": 2},
      {"variable": "qty[c]", "coefficient": 1}
    ],
    "quadratic_terms": [{"variable1": "bonus", "variable2": "pick[a]", "coefficient": 1}]
  },
  "constraints": [
    {
      "id": "bonus_needs_a",
      "type": "hard",
      "terms": [{"variable": "bonus", "coefficient": 1}, {"variable": "pick[a]", "coefficient": -1}],
      "operator": "<=",
      "rhs": 0
    },
    {
      "id": "budget",
      "description": "Units and picks share one budget",
      "type": "hard",
      "terms": [
        {"variable": "qty[a]", "coefficient": 1},
        {"variable": "qty[b]", "coefficient": 2},
        {"variable": "qty[c]", "coefficient": 1},
        {"variable": "pick[a]", "coefficient": 2},
        {"variable": "pick[b]", "coefficient": 1},
        {"variable": "pick[c]", "coefficient": 1}
      ],
      "operator": "<=",
      "rhs": 4
    },
    {
      "id": "prefer_small[a]",
      "description": "Rather few extra units",
      "type": "soft",
      "terms": [{"variable": "qty[a]", "coefficient": 1}],
      "operator": "<=",
      "rhs": 1,
      "weight": 2
    },
    {
      "id": "prefer_small[b]",
      "description": "Rather few extra units",
      "type": "soft",
      "terms": [{"variable": "qty[b]", "coefficient": 1}],
      "operator": "<=",
      "rhs": 0,
      "weight": 0.5
    },
    {
      "id": "prefer_small[c]",
      "description": "Rather few extra units",
      "type": "soft",
      "terms": [{"variable": "qty[c]", "coefficient": 1}],
      "operator": "<=",
      "rhs": 0,
      "weight": 1.5
    }
  ],
  "cardinality_constraints": [
    {"id": "at_least_one", "type": "hard", "variables": ["pick[a]", "pick[b]", "pick[c]"], "operator": ">=", "rhs": 1},
    {"id": "group_limit[g1]", "description": "At most limit[g] picks per group", "type": "hard", "variables": ["pick[a]", "pick[b]"], "operator": "<=", "rhs": 1},
    {"id": "group_limit[g2]", "description": "At most limit[g] picks per group", "type": "hard", "variables": ["pick[b]", "pick[c]"], "operator": "<=", "rhs": 1}
  ],
  "solver": {"backend": "exact"}
}
